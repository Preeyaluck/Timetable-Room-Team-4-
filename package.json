{
  "name": "timetable-room-api",
  "version": "1.0.0",
  "description": "Identity & Academic Core - Timetable & Room (Team 4) Cloudflare Workers + D1 API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "npx wrangler dev",
    "deploy": "npx wrangler deploy",
    "db:migrate:local": "npx wrangler d1 execute timetable-room-db --local --file=./migrations/0001_initial_schema.sql",
    "db:seed:local": "npx wrangler d1 execute timetable-room-db --local --file=./migrations/0002_seed_data.sql",
    "db:migrate:remote": "npx wrangler d1 execute timetable-room-db --remote --file=./migrations/0001_initial_schema.sql",
    "db:seed:remote": "npx wrangler d1 execute timetable-room-db --remote --file=./migrations/0002_seed_data.sql"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "marked": "^18.0.13",
    "typescript": "^5.6.0"
  }
}
